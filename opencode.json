{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "mcp": {
    "timeout": {
      "startup": 45000,
      "catalog": 30000,
      "execution": 120000
    },
    "servers": {
      "livekit-docs": {
        "type": "remote",
        "url": "https://docs.livekit.io/mcp",
        "oauth": false,
        "codemode": false
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--isolated"
        ],
        "codemode": false
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chrome"
        ],
        "codemode": false
      }
    }
  }
}
